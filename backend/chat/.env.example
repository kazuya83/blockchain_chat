NODE_ENV=development
PORT=4100
CORS_ORIGINS=http://localhost:3100

# --- database ---
DB_HOST=127.0.0.1
DB_PORT=33070
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=blockchain_chat_local
DB_SSL=false

# --- Claude API ---
# 未設定でも `ant auth login` のプロファイルがあれば SDK が拾う
ANTHROPIC_API_KEY=
CHAT_DEFAULT_MODEL_ID=claude-opus-5
CHAT_MAX_OUTPUT_TOKENS=64000

# --- chain ---
# 80002 = Polygon Amoy（テストネット） / 137 = Polygon mainnet / 31337 = ローカル
CHAIN_ID=31337
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_CHAT_CREDIT_ADDRESS=
CHAIN_CHAT_LOG_ANCHOR_ADDRESS=
# anchor TX を出すバックエンドの秘密鍵（0x 始まり）。未設定ならアンカーは無効。
CHAIN_ANCHORER_PRIVATE_KEY=
# 入金 1 クレジットあたりの wei。1e14 wei = 0.0001 POL で 1 クレジット。
CHAIN_WEI_PER_CREDIT=100000000000000
# 入金イベントを確定とみなすまでの確認ブロック数
CHAIN_CONFIRMATIONS=5
# 取り込みを開始するブロック（コントラクトのデプロイブロック）
CHAIN_DEPOSIT_FROM_BLOCK=0

# --- session ---
SESSION_TTL_HOURS=720
